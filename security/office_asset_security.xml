<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Internal User: only see own loans -->
        <record id="rule_office_asset_loan_user" model="ir.rule">
            <field name="name">Personal Office Asset Loans</field>
            <field name="model_id" ref="model_office_asset_loan"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('borrower_id', '=', user.id)]</field>
        </record>

        <!-- System Administrator: see all loans -->
        <record id="rule_office_asset_loan_manager" model="ir.rule">
            <field name="name">All Office Asset Loans for Administrator</field>
            <field name="model_id" ref="model_office_asset_loan"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>

