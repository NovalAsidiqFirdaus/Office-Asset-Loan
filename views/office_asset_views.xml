<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="view_office_asset_list" model="ir.ui.view">
            <field name="name">office.asset.list</field>
            <field name="model">office.asset</field>
            <field name="arch" type="xml">
                <list string="Assets">
                    <field name="code" string="Asset Code" />
                    <field name="name" string="Asset Name" />
                    <field name="category" string="Category" />
                    <field name="condition" string="Condition" widget="badge"
                        decoration-success="condition == 'good'"
                        decoration-warning="condition == 'fair'"
                        decoration-danger="condition == 'damaged'" />
                    <field name="is_available" string="Available" widget="boolean_toggle" />
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_office_asset_form" model="ir.ui.view">
            <field name="name">office.asset.form</field>
            <field name="model">office.asset</field>
            <field name="arch" type="xml">
                <form string="Office Asset">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_loans" type="object"
                                class="oe_stat_button" icon="fa-book">
                                <field name="loan_count" widget="statinfo" string="Loans" />
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Asset Name" />
                            <h1>
                                <field name="name" placeholder="e.g. Epson EB-X400 Projector" />
                            </h1>
                            <h3>
                                <field name="code" placeholder="e.g. AST-001" />
                            </h3>
                        </div>
                        <group>
                            <group string="Asset Details">
                                <field name="category" string="Category" />
                                <field name="condition" string="Condition" />
                                <field name="purchase_date" string="Purchase Date" />
                            </group>
                            <group string="Availability Status">
                                <field name="is_available" string="Available"
                                    widget="boolean_toggle" readonly="1"
                                    help="Automated status: Green when free, Gray when borrowed. Managed by system." />
                                <field name="active" string="Active"
                                    help="Uncheck to archive and hide this asset from active listings." />
                            </group>
                        </group>
                        <notebook>
                            <page string="Loan History" name="loan_history">
                                <field name="loan_ids" readonly="1">
                                    <list>
                                        <field name="name" string="Loan Number" />
                                        <field name="borrower_id" string="Borrower" />
                                        <field name="loan_date" string="Loan Date" />
                                        <field name="return_date" string="Return Date" />
                                        <field name="state" string="Status" widget="badge"
                                            decoration-info="state == 'draft'"
                                            decoration-warning="state == 'borrowed'"
                                            decoration-success="state == 'returned'"
                                            decoration-muted="state == 'cancelled'" />
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="note"
                                    placeholder="Write additional technical specs or asset notes here..." />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_office_asset_search" model="ir.ui.view">
            <field name="name">office.asset.search</field>
            <field name="model">office.asset</field>
            <field name="arch" type="xml">
                <search string="Search Assets">
                    <field name="name" string="Asset Name" />
                    <field name="code" string="Asset Code" />
                    <filter name="filter_available" string="Available"
                        domain="[('is_available', '=', True)]" />
                    <group>
                        <filter string="Category" name="group_category"
                            context="{'group_by': 'category'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- Window Action -->
        <record id="action_office_asset" model="ir.actions.act_window">
            <field name="name">Assets</field>
            <field name="res_model">office.asset</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_office_asset_search" />
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No office assets registered yet!
                </p>
                <p>
                    Click New to register your first office inventory item.
                </p>
            </field>
        </record>
    </data>
</odoo>